# Copy to .env and fill in. .env is gitignored (never committed).

# ── Database (Neon) ───────────────────────────────────────────
# Pooled connection string from the Neon dashboard.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── CRM adapter (shadow by default — not needed to run the demo) ──
# The example adapter targets a MarketSharp-style "submit lead" REST API. In shadow mode the pipeline
# only computes what it WOULD send, so these can stay blank. SUBMIT_URL + API_KEY = "CRM configured".
MARKETSHARP_SUBMIT_URL=""     # the lead-submit endpoint
MARKETSHARP_API_KEY=""        # write-only key
MARKETSHARP_API_BASE=""       # (future) REST base for reads/parity

# ── Twilio (inbound-call receiver — optional) ─────────────────
# Only needed to wire the phone-call paths. Not required for the web/vendor demo.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_INSTACALL_FLOW_SID=""
TWILIO_INSTACALL_FROM=""

# ── Receiver shared secret (verify inbound webhooks) ──────────
# If set, receivers require this token (x-webhook-secret header) so only real senders can post.
# Leave blank locally; set it in production and pass it to scripts/demo-seed.mjs.
RECEIVER_WEBHOOK_SECRET=""

# ── Cron auth ─────────────────────────────────────────────────
# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`; set this in the Vercel project env too.
CRON_SECRET=""

# ── Dashboard auth (ops UI) ───────────────────────────────────
# Optional shared-password gate for the dashboard/leads/export. Leave blank for open access (demo).
DASHBOARD_PASSWORD=""

# ── Pipeline behavior ─────────────────────────────────────────
# Master shadow switch. "true" (or unset) = every source stays shadow (normalize + log would_write, no
# CRM write) — the safe default, and what the demo runs in. Set "false" only to begin live cutover.
PIPELINE_SHADOW_MODE="true"
# Per-source cutover opt-in (comma-separated canonical sources). A source writes LIVE only when
# PIPELINE_SHADOW_MODE=false AND it is listed here AND CRM creds are set. Default empty = none.
PIPELINE_LIVE_SOURCES=""
# Business-hours timezone.
PIPELINE_TIMEZONE="America/Chicago"
# Cross-source dedupe window (days): flag a lead as a likely dup if its phone/email appeared this recently.
PIPELINE_DEDUPE_WINDOW_DAYS="30"
